# Local service ports
SHELL_PORT=3000
MS_AUTH_PORT=3001
MFE_AUTH_PORT=4001
MS_ASSESSMENT_PORT=3002
MFE_ASSESSMENT_PORT=4002
DB_PORT=5432
MINISTACK_PORT=4566

# PostgreSQL
DB_NAME=chave_auth
DB_USER=chave
DB_PASSWORD=chave_secret

# Assessment Service (Grupo 1 — T2). Uses its own database (database-per-service).
# ADMIN_ROLE must match the role name issued in the JWT by the elected MS Auth.
DB_ASSESSMENT_NAME=chave_assessment
ADMIN_ROLE=admin
# Group Service (G4) URL to resolve a user's groups in GET /assessments/available.
# Leave empty until the contract is defined (USER assignments still resolve).
GROUP_SERVICE_URL=

# JWT and token lifetimes
JWT_SECRET=local-development-jwt-secret-change-me-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_RESET_TOKEN_TTL=30m

# Refresh cookie settings
REFRESH_COOKIE_NAME=chave_refresh_token
REFRESH_COOKIE_PATH=/auth/refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_MAX_AGE_SECONDS=604800

# Optional browser-facing URL overrides.
# By default, make setup provisions a Ministack API Gateway and writes the
# generated gateway URL to .env.generated as AUTH_API_PUBLIC_URL.
# Uncomment AUTH_API_PUBLIC_URL only when you explicitly want to bypass the
# generated gateway URL.
# Uncomment these only when using a non-localhost hostname or custom path.
# AUTH_API_PUBLIC_URL=http://localhost:3001
# MFE_AUTH_PUBLIC_URL=http://localhost:4001
# MFE_AUTH_PUBLIC_REMOTE_URL=http://localhost:4001/assets/remoteEntry.js
# SHELL_PUBLIC_URL=http://localhost:3000
# FRONTEND_CORS_ORIGINS=http://localhost:3000,http://localhost:4001
# RESET_PASSWORD_FRONTEND_URL=http://localhost:4001/reset-password

# Seed admin account
SEED_ADMIN_EMAIL=admin@chave.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Admin Chave

# AWS / Ministack
MINISTACK_IMAGE=ministackorg/ministack
MINISTACK_SERVICES=s3,apigateway,sts
MINISTACK_DEBUG=0
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566

# Terraform provisioning / generated gateway URL
TF_VAR_ARTIFACT_BUCKET=chave-artifacts-local
